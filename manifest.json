{
  "update_url": "https://clients2.google.com/service/update2/crx",
  "name": "Middle Click to Search",
  "description": "Middle click highlighted text to do a search with that text in a new tab.",
  "version": "0.2.0",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "get_text.js"
      ],
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "icons": {
    "16": "Middle_Click16.png",
    "48": "Middle_Click48.png",
    "128": "Middle_Click128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "minimum_chrome_version": "102",
  "action": {
    "default_title": "Middle Click to Search settings"
  }
}
